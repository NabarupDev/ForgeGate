{
  "name": "forge-gate-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "ForgeGate - Distributed Backend Workflow Platform",
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" run build && pnpm --filter \"./apps/*\" run build",
    "lint": "pnpm -r run lint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "ts-node prisma/seed.ts",
    "start:dev": "pnpm --filter api-gateway run start:dev",
    "docker:up": "docker-compose -f infra/docker/docker-compose.yml up -d",
    "docker:down": "docker-compose -f infra/docker/docker-compose.yml down"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
