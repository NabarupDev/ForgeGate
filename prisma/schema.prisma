// Prisma Schema for ForgeGate Distributed Backend Workflow Platform

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["auth", "workflow", "audit", "billing"]
}

// ----------------------------------------------------
// AUTH DOMAIN (schema: "auth") - Owned by Auth Service
// ----------------------------------------------------

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("tenants")
  @@schema("auth")
}

model User {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  email        String   @unique
  passwordHash String?  @map("password_hash")
  name         String
  isActive     Boolean  @default(true) @map("is_active")
  roleId       String   @map("role_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role          Role           @relation(fields: [roleId], references: [id])
  oauthAccounts OAuthAccount[]
  refreshTokens RefreshToken[]

  @@index([tenantId])
  @@index([roleId])
  @@map("users")
  @@schema("auth")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // 'admin', 'moderator', 'user'
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  users       User[]
  permissions RolePermission[]

  @@map("roles")
  @@schema("auth")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?

  roles RolePermission[]

  @@map("permissions")
  @@schema("auth")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
  @@schema("auth")
}

model OAuthAccount {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  provider       String
  providerUserId String   @map("provider_user_id")
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@map("oauth_accounts")
  @@schema("auth")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revoked])
  @@map("refresh_tokens")
  @@schema("auth")
}

// ----------------------------------------------------------------
// WORKFLOW ENGINE DOMAIN (schema: "workflow") - Owned by Workflow Service
// ----------------------------------------------------------------

model Workflow {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  triggerType String   @default("webhook") @map("trigger_type") // 'webhook', 'cron', 'event'
  isActive    Boolean  @default(true) @map("is_active")
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  steps      WorkflowStep[]
  executions WorkflowExecution[]

  @@index([tenantId, createdAt])
  @@index([createdById])
  @@map("workflows")
  @@schema("workflow")
}

model WorkflowStep {
  id         String @id @default(uuid())
  workflowId String @map("workflow_id")
  stepOrder  Int    @map("step_order")
  actionType String @map("action_type") // 'http_request', 'email_notification', 'data_transform'
  config     Json
  retryLimit Int    @default(3) @map("retry_limit")

  workflow       Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  stepExecutions StepExecution[]

  @@index([workflowId, stepOrder])
  @@map("workflow_steps")
  @@schema("workflow")
}

model WorkflowExecution {
  id          String    @id @default(uuid())
  workflowId  String    @map("workflow_id")
  tenantId    String    @map("tenant_id")
  status      String    @default("pending") // 'pending', 'running', 'completed', 'failed', 'retrying'
  currentStep Int       @default(1) @map("current_step")
  version     Int       @default(1)
  metadata    Json?
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")

  workflow       Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  logs           ExecutionLog[]
  stepExecutions StepExecution[]

  @@index([tenantId, startedAt])
  @@index([workflowId, startedAt])
  @@index([tenantId, status])
  @@map("workflow_executions")
  @@schema("workflow")
}

model ExecutionLog {
  id          String   @id @default(uuid())
  executionId String   @map("execution_id")
  stepId      String?  @map("step_id")
  status      String
  output      Json?
  error       String?
  createdAt   DateTime @default(now()) @map("created_at")

  execution WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, createdAt])
  @@map("execution_logs")
  @@schema("workflow")
}

enum StepExecutionStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  TIMED_OUT
  CANCELLED

  @@schema("workflow")
}

model StepExecution {
  id          String              @id @default(uuid())
  executionId String              @map("execution_id")
  stepId      String              @map("step_id")
  attempt     Int                 @default(1)
  status      StepExecutionStatus @default(PENDING)
  startedAt   DateTime?           @map("started_at")
  finishedAt  DateTime?           @map("finished_at")
  input       Json?
  output      Json?
  error       String?
  workerId    String?             @map("worker_id")
  heartbeatAt DateTime?           @map("heartbeat_at")
  version     Int                 @default(1)
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  execution WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  step      WorkflowStep      @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@index([status])
  @@index([executionId, stepId, attempt])
  @@index([executionId, stepId, status])
  @@index([status, heartbeatAt])
  @@index([status, startedAt])
  @@map("step_executions")
  @@schema("workflow")
}

// ----------------------------------------------------
// AUDIT DOMAIN (schema: "audit") - Owned by Audit Service
// ----------------------------------------------------

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String?  @map("tenant_id")
  userId    String?  @map("user_id")
  action    String
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
  @@schema("audit")
}

// --------------------------------------------------------
// BILLING DOMAIN (schema: "billing") - Owned by Billing Service
// --------------------------------------------------------

model Subscription {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  userId           String   @map("user_id")
  planName         String   @map("plan_name")
  status           String   @default("active")
  currentPeriodEnd DateTime @map("current_period_end")

  @@index([tenantId, status])
  @@index([userId])
  @@map("subscriptions")
  @@schema("billing")
}
