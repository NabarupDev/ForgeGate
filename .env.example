# ==============================================================================
# ForgeGate Local Development Environment Template
# Instructions: Copy this file to '.env' and fill in secret keys for your environment.
# Note: Never commit your active '.env' file to version control.
# ==============================================================================

# Application Configuration
PORT=3000
NODE_ENV=development
APP_NAME=ForgeGate
API_PREFIX=api/v1

# Database (PostgreSQL)
POSTGRES_USER=forgegate_user
POSTGRES_PASSWORD=dev_postgres_password
POSTGRES_DB=forgegate_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://forgegate_user:dev_postgres_password@localhost:5432/forgegate_db?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE=notifications_queue

# Authentication / JWT Secrets (Change these in production!)
JWT_ACCESS_SECRET=dev_jwt_access_secret_change_in_prod
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_change_in_prod
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OAuth (Google / GitHub)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/google/callback

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/github/callback

# SMTP / Email (Mock / Ethereal / Mailtrap)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-pass
EMAIL_FROM="ForgeGate System <noreply@forgegate.local>"
