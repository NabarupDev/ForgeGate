{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "paths": {
      "@forgegate/common": ["packages/common/dist"],
      "@forgegate/logger": ["packages/logger/dist"],
      "@forgegate/auth": ["packages/auth/dist"],
      "@forgegate/config": ["packages/config/dist"]
    }
  }
}
